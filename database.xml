<?xml version="1.0" encoding="UTF-8"?>
<database>

    <global>
        <table name="cron">
            <field type="integer" autoincrement="true" primary="true">id</field>
            <field type="smallint" nullable="true">active</field>
            <field type="string" length="1000">title</field>
            <field type="string" length="128">min</field>
            <field type="string" length="128">hour</field>
            <field type="string" length="128">day</field>
            <field type="string" length="128">month</field>
            <field type="string" length="128">dayOfWeek</field>
            <field type="text">exec</field>
            <field type="text">params</field>
            <field type="datetime" nullable="true" default="null">lastexec</field>
            <field type="datetime" default="CURRENT_TIMESTAMP">createDate</field>
        </table>

        <table name="cron_history">
            <field type="integer" autoincrement="true" primary="true">id</field>
            <field type="integer">cronid</field>
            <field type="string" length="50">uid</field>
            <field type="datetime">lastexec</field>
            <field type="datetime" nullable="true" default="null">finish</field>

            <index>cronid</index>
            <index>lastexec</index>
            <index>uid</index>
        </table>

        <table name="cron_cronservice">
            <field type="integer">cronid</field>
            <field type="string" length="50">uid</field>
            <field type="datetime">lastexec</field>

            <index>cronid</index>
        </table>
    </global>

</database>
